.hutong-color-preset-picker {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 10px;
}

.hutong-color-preset-picker__separator {
    width: 100%;
    height: 8px;
}

.hutong-color-preset-picker__item {
    flex-direction: row;
    align-items: center;
    width: 140px;
    height: 32px;
}

.hutong-color-preset-picker__item .hutong-color-preset-picker__color-button {
    flex-shrink: 0;
    margin-right: 4px;
}

.hutong-color-preset-picker__item > Label {
    height: 24px;
    margin-top: 4px;
    -unity-text-align: middle-left;
}

.hutong-color-preset-picker__item:hover {
    background-color: var(--unity-colors-alternated_rows-background);
}

.hutong-color-preset-picker__color-button {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    margin-left: 4px;
    margin-top: 4px;
    border-width: 1px;
    border-color: rgb(50,50,50);
}

.hutong-color-preset-picker__color-button--selected {
    border-color: var(--unity-colors-highlight-background);
    border-width: 2px;
}

.hutong-color-preset-picker__color-button:hover {
    border-color: var(--unity-colors-highlight-background);
}
